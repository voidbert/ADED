digraph SparkLogicalPlanOg2 {

    // === Global configuration ===

    graph [
        rankdir  = BT,
        ranksep  = 0.7,
        splines  = true,
        sep      = "+0.2",
        fontname = "Helvetica",
        bgcolor  = "transparent"
    ];

    node [
        fontname  = "Helvetica",
        fontsize  = 11,
        shape     = record,
        style     = "filled,rounded",
        penwidth  = 0.5,
        margin    = "0.25,0.14",
        fillcolor = "#FAECE7",
        color     = "#993C1D",
        fontcolor = "#712B13"
    ];

    edge [
        fontname  = "Helvetica",
        fontsize  = 10,
        color     = "black",
        arrowsize = 0.7,
        penwidth  = 0.8
    ];

    // === Nodes ===

    relation_1 [label = "{Relation #1 | Read CSV #1\n}"];
    filter_1   [label = "{Filter   #1 | Filter columns Account and Partition\n}"];
    project_1  [label = "{Project  #1 | withColumn: [ cluster, totalJobSeconds ]\n}"];

    ellipsis [
        label     = "...",
        shape     = plaintext,
        style     = "",
        fontsize  = 20,
        fontcolor = "black"
    ];

    relation_12 [label = "{Relation #12 | Read CSV #12\n}"];
    filter_12   [label = "{Filter   #12 | Filter columns Account and Partition\n}"];
    project_12  [label = "{Project  #12 | withColumn: [ cluster, totalJobSeconds ]\n}"];

    union [label = "{Union | Union all 12 Relation/Filter/Project\l}"];

    aggregate [
        label = "{Aggregate |
                  groupBy:  [ cluster ]\l
                  aggregate:  sum(totalJobSeconds) AS sum(totalJobSeconds)\l
                  output: [ cluster, sum(totalJobSeconds) ]\l}"
    ];

    // === Edges ===

    relation_1 -> filter_1;
    filter_1   -> project_1;

    relation_12 -> filter_12;
    filter_12   -> project_12;

    project_1  -> union;
    ellipsis   -> union;
    project_12 -> union;

    union -> aggregate
}
