digraph SparkLogicalPlanMultipass {

    // === Global configuration ===

    graph [
        rankdir  = BT,
        ranksep  = 0.7,
        splines  = true,
        sep      = "+0.2",
        fontname = "Helvetica",
        bgcolor  = "transparent"
    ];

    node [
        fontname  = "Helvetica",
        fontsize  = 11,
        shape     = record,
        style     = "filled,rounded",
        penwidth  = 0.5,
        margin    = "0.25,0.14",
        fillcolor = "#FAECE7",
        color     = "#993C1D",
        fontcolor = "#712B13"
    ];

    edge [
        fontname  = "Helvetica",
        fontsize  = 10,
        color     = "black",
        arrowsize = 0.7,
        penwidth  = 0.8
    ];


    // === Nodes ===

    relation_1 [label = "{Relation #1 | Read CSV #1\n}"];
    project_1  [label = "{Project  #1 |
                          withColumn: [ Period, cluster, Agency, totalJobSeconds ]\n}"];

    ellipsis [
        label     = "...",
        shape     = plaintext,
        style     = "",
        fontsize  = 20,
        fontcolor = "black"
    ];

    relation_12 [label = "{Relation #12 | Read CSV #12\n}"];
    project_12  [label = "{Project  #12 |
                          withColumn: [ Period, cluster, Agency, totalJobSeconds ]\n}"];

    union [label = "{Union | Union all 12 Relation/Project pairs\n}"];

    aggregate [
        label = "{Aggregate |
                  groupBy:  [ Period, cluster, Agency, COMPLETED ]\l
                  aggregate:  count(1) AS job_count\l
                  aggregate:  sum(totalJobSeconds) AS total_secs\l
                  output:  [ Period, cluster, Agency, COMPLETED, job_count, total_secs ]\l}"
    ];

    // === Edges ===

    relation_1  -> project_1;
    relation_12 -> project_12;

    project_1  -> union;
    ellipsis   -> union;
    project_12 -> union;

    union -> aggregate
}
